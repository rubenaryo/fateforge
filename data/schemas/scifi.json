        "PHY": { "type": "roll", "min": 4, "max": 12 },
        "REF": { "type": "roll", "min": 4, "max": 12 },
        "INT": { "type": "roll", "min": 4, "max": 12 },
        "WIL": { "type": "roll", "min": 4, "max": 12 },
        "CHA": { "type": "roll", "min": 4, "max": 12 },
        "TEC": { "type": "roll", "min": 4, "max": 12 }
      }
    },
    "skills": { "type": "pickMany", "source": "skills", "count": 4 },
    "augmentations": { "type": "pickMany", "source": "augmentations", "count": 2 },
    "loadout": {
      "type": "group",
      "children": {
        "primary":   { "type": "pick", "source": "weapons" },
